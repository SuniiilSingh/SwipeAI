# ==============================================================================
# SwipeAI — Production Environment Configuration (.env.prod)
# Copy this file to .env.prod on your Hetzner server:
# cp .env.prod.example .env.prod
# ==============================================================================

# Database Credentials
POSTGRES_DB=swipeai_prod
POSTGRES_USER=swipeai_admin
POSTGRES_PASSWORD=generate_a_super_strong_password_here_12345!
DB_POOL_MAX=25
DB_POOL_MIN_IDLE=5
HIBERNATE_DDL_AUTO=update

# Application Security Keys (Must be long, random hex/alphanumeric strings)
JWT_SECRET=generate_a_secure_jwt_secret_key_minimum_64_characters_for_hmac_sha512
JWT_EXPIRATION_MS=2592000000
SERVER_PEPPER=generate_a_random_32_byte_pepper_for_password_hashing
CHAT_ENCRYPTION_KEY=generate_a_secure_32_byte_aes256_key_for_chat_encryption_
PAYMENT_ENCRYPTION_KEY=generate_a_secure_32_byte_aes256_key_for_payment_vault_

# Twilio SMS / WhatsApp OTP
FEATURE_TWILIO_ENABLED=true
FEATURE_MOCK_OTP=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid_here

# Cashfree Payments (Direct UPI & Alternative Billing)
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENV=PRODUCTION

# Razorpay (Optional fallback)
FEATURE_RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 Media Storage (S3 Compatible Profile & Media Storage)
FEATURE_R2_STORAGE_ENABLED=true
R2_ACCOUNT_ID=8b7676964aeeef6ddf51ea48d842d4d0
R2_ACCESS_KEY_ID=c999c7ef7f0f5311c6a317b63f08a0df
R2_SECRET_ACCESS_KEY=9625b1e46a7b248da81a1d2be827b3de668bbd04360581eabcaa43a6157bb557
R2_BUCKET_NAME=blunderr-media
R2_PUBLIC_DOMAIN=https://pub-f218f1444ed840668824b64cd9e1f00d.r2.dev

# LiveKit Audio/Video Calling
FEATURE_LIVEKIT_ENABLED=true
LIVEKIT_HOST=wss://livekit.swipeai.in
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI Wingman (OpenAI / DeepSeek)
FEATURE_AI_WINGMAN_ENABLED=true
OPENAI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4o-mini
